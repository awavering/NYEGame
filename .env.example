# Copy to .env (git ignores it). `make` loads it automatically.
# For a plain `python app.py`, load it first:  set -a; . ./.env; set +a

HOST_KEY=change-me
PORT=5000
TZ_NAME=America/Denver

# BASE_URL=https://my-tunnel.example.com   # public address, if behind a tunnel or host (used in QR codes)
# MIDNIGHT_ISO=2026-12-31T22:00:00         # fake the clock (read in TZ_NAME); `make dev` sets this for you
# GAME_DATA_DIR=./data                     # where state.json and uploads/ go
# CARDS_FILE=./cards.json                  # use a different card file
